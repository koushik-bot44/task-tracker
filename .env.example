# Postgres. On Vercel these two are injected by the Neon integration; locally,
# `vercel env pull` fetches them. DATABASE_URL is the pooled connection the app
# uses; DATABASE_URL_UNPOOLED is the direct one Prisma needs for migrations,
# which cannot run through the pooler.
DATABASE_URL="postgresql://user:password@host:5432/orbit?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/orbit?sslmode=require"

# The single passcode that unlocks the app. This is the entire security model.
APP_PASSCODE="change-me"

# Signing key for the session cookie. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="change-me-to-something-long-and-random"
