# Postgres. On Vercel these two are injected by the Neon integration; locally,
# `vercel env pull` fetches them. DATABASE_URL is the pooled connection the app
# uses; DATABASE_URL_UNPOOLED is the direct one Prisma needs for migrations,
# which cannot run through the pooler.
DATABASE_URL="postgresql://user:password@host:5432/orbit?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/orbit?sslmode=require"

# The single passcode that unlocks first-run bootstrap.
APP_PASSCODE="change-me"

# Signing key for the session cookie AND the emailed meeting-reply links. 32+ random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="change-me-to-something-long-and-random"

# The evening-before message runs from Vercel Cron (vercel.json, 18:00 IST).
# Vercel sends this as `Authorization: Bearer <secret>`; anything else is 401.
CRON_SECRET="change-me"

# Email (message a/b/c + invites). Leave unset to disable email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Orbit <orbit@example.com>"

# WhatsApp via Twilio (message a/b/c). Leave unset to disable WhatsApp.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Optional approved template (two variables {{1}} {{2}}); freeform body when unset.
TWILIO_CONTENT_SID=""

# Web push. Generate with: npx tsx scripts/gen-vapid.ts
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Photos and files on notes (Vercel Blob). Leave unset to hide the camera and
# paper-clip everywhere. Locally, a disk fallback under .localdb/uploads is used.
BLOB_READ_WRITE_TOKEN=""

# Absolute base URL for links in messages (falls back to the Vercel production URL).
APP_URL=""
