{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "test:parser": "tsx scripts/check-quick-add.ts",
    "test:cross-list": "tsx scripts/check-cross-list.ts",
    "screens": "tsx scripts/screens.ts",
    "contrast": "tsx scripts/contrast.ts",
    "tokens": "tsx scripts/tokens.ts",
    "clean:shots": "tsx scripts/clean-shots.ts",
    "matrix": "npm run clean:shots && tsx --env-file=.env scripts/matrix.ts",
    "tooltips": "tsx --env-file=.env scripts/tooltip-check.ts",
    "panel-writes": "tsx --env-file=.env scripts/panel-writes.ts",
    "overlays": "tsx --env-file=.env scripts/overlay-check.ts",
    "integrity": "tsx scripts/integrity.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.101.3",
    "cmdk": "^1.1.1",
    "fractional-indexing": "^4.0.0",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "next": "14.2.35",
    "nodemailer": "^6.10.1",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.61.1",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
