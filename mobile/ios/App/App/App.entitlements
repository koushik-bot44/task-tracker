<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability (silent "Locate Now" pushes).
	     "development" for builds run from Xcode; an archive signed for
	     TestFlight / App Store gets "production" from its provisioning profile. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
